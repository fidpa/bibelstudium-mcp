{
  "compilerOptions": {
    // Umgebung und aktuelle Sprachstufe
    "lib": ["ESNext"],
    "target": "ESNext",
    "types": ["bun"],
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,

    // Bundler-Auflösung: Bun führt .ts direkt aus, Importe tragen deshalb die
    // .ts-Endung.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Bewährte Vorgaben
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Strengere Schalter, bewusst abgeschaltet
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // Ohne diese Zeile prüft tsc jede .ts im Baum, auch gitignorierte: Eine
  // Wegwerfdatei unter tmp/ oder eine Arbeitskopie neben dem Projekt machte den
  // Typecheck rot, ohne dass am Projekt etwas falsch wäre (gemessen 23.08.2026).
  // Ein exclude braucht es nicht, es liegt kein vendoriertes Fremdgut im Baum.
  //
  // Gegen einen Symlink INNERHALB dieser drei Bäume schützt die Zeile nicht:
  // tsc folgt ihm und prüft, was dahinter liegt (ebenfalls gemessen). Deshalb
  // bleibt das Symlink-Verbot der Arbeitsanweisung bestehen.
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
