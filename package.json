{
  "name": "bibelstudium-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for word-precise Bible study: four freely licensed German translations, original-language morphology (Hebrew WLC; Greek Majority Text / SBLGNT / Textus Receptus), concordance, cross-references, full-text search, and edition comparison with eight-edition attestation.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run server.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "download": "bun run download.ts",
    "download:byz": "bun run download-byz.ts",
    "download:sblgnt": "bun run download-morph.ts",
    "download:tr": "bun run download-tr.ts",
    "download:heb": "bun run download-heb.ts",
    "download:crossrefs": "bun run download-crossrefs.ts",
    "download:tagnt": "bun run download-tagnt.ts",
    "download:lexicon": "bun run download-lexicon.ts",
    "build:fts": "bun run build-fts.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
